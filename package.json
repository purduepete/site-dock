{
  "name": "sitedock",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local, authenticated favorites dashboard with Tailscale access.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:frontend\"",
    "dev:server": "node --env-file-if-exists=.env --env-file=.env.development --import tsx --watch server/main.ts",
    "dev:frontend": "vite --config frontend/vite.config.ts --host 127.0.0.1",
    "typecheck": "tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.frontend.json",
    "build": "npm run typecheck && tsc -p tsconfig.server.json && vite build --config frontend/vite.config.ts",
    "preview": "vite preview --config frontend/vite.config.ts",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:server": "tsc -p tsconfig.server.json && node --test dist/server/*.test.js",
    "test:frontend": "vitest run --config frontend/vite.config.ts",
    "test": "npm run test:server && npm run test:frontend && npm run test:startup",
    "test:e2e": "playwright test",
    "test:startup": "node --test tests/startup.test.mjs",
    "test:postgres": "tsc -p tsconfig.server.json && node --test dist/server/postgres.integration.js",
    "test:postgres:import": "tsc -p tsconfig.server.json && node --test dist/server/postgresImport.integration.js",
    "owner": "node --env-file-if-exists=.env --import tsx server/owner.ts",
    "start": "node --env-file-if-exists=.env dist/server/main.js",
    "update": "pwsh -NoProfile -File scripts/update.ps1",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource-variable/roboto-flex": "^5.2.0",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.56.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^27.0.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "prettier --write",
      "eslint --max-warnings 0 --no-warn-ignored"
    ],
    "*.{json,css,md,html}": [
      "prettier --write"
    ]
  }
}
